# Plantilla: copiar una vez a .env y editar solo la copia local.
# PGPASSWORD debe ser la contraseña propia del usuario aula_app.
# .env no se versiona. PORT es HTTP; PGPORT es PostgreSQL.
NODE_ENV=development
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=aula_circular
PGUSER=aula_app
PGPASSWORD=RELLENAR_SOLO_EN_ENV_LOCAL