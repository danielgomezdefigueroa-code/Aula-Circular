# Plantilla local. Copiar a .env y completar solo en local.
# Deja SESSION_SECRET vacío y ejecuta: npm.cmd run preparar
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=aula_circular
PGUSER=aula_app
PGPASSWORD=RELLENAR_SOLO_EN_ENV_LOCAL
SESSION_SECRET=

# Pon 1 solo si hay un proxy inverso de confianza delante del servidor.
TRUST_PROXY=0
